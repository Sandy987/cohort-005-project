{
  "name": "Comment reply",
  "description": "Tells the author of a top-level comment that someone replied to it. Triggered by createComment when it creates a reply.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    }
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "comment-reply",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
