# Copy to .env (gitignored). Every variable is optional for local dev.

# Postmark. Without it, emails are written to .outbox/
POSTMARK_SERVER_TOKEN=

# Knock in-app Notifications. Without the secret key, Notifications are
# written to .outbox/notifications/. Without the public key, feed channel id
# or signing key, no Knock provider is mounted and the sidebar item is hidden.
KNOCK_SECRET_API_KEY=
KNOCK_PUBLIC_API_KEY=
KNOCK_FEED_CHANNEL_ID=
# Enhanced security signing key (PEM or base64-encoded PEM) from Knock:
# Developers > API keys > Signing keys. Signs 1h user tokens for the feed.
KNOCK_SIGNING_KEY=
